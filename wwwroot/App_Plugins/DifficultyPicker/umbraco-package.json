{
  "id": "outdoorguide.difficulty-picker",
  "name": "Difficulty Picker",
  "version": "1.0.0",
  "allowTelemetry": false,
  "extensions": [
    {
      "type": "propertyEditorUi",
      "alias": "OutdoorGuide.PropertyEditorUi.DifficultyPicker",
      "name": "Difficulty Picker",
      "element": "/App_Plugins/DifficultyPicker/difficulty-picker.element.js",
      "elementName": "outdoorguide-difficulty-picker",
      "meta": {
        "label": "Difficulty Picker",
        "icon": "icon-flag",
        "group": "pickers",
        "propertyEditorSchemaAlias": "Umbraco.Plain.String"
      }
    },
    {
      "type": "localization",
      "alias": "OutdoorGuide.DifficultyPicker.Localization.En",
      "name": "Difficulty Picker (English)",
      "meta": {
        "culture": "en"
      },
      "js": "/App_Plugins/DifficultyPicker/lang/en.js"
    },
    {
      "type": "localization",
      "alias": "OutdoorGuide.DifficultyPicker.Localization.Sv",
      "name": "Difficulty Picker (Svenska)",
      "meta": {
        "culture": "sv"
      },
      "js": "/App_Plugins/DifficultyPicker/lang/sv.js"
    }
  ]
}
