@using OutdoorGuide.Models.ViewModels
@using Umbraco.Cms.Web.Website.Controllers
@inherits UmbracoViewPage<AccountPageViewModel>

@{
	Layout = "root.cshtml";

	string Text(string key, string defaultValue) => Umbraco.GetDictionaryValueOrDefault(key, defaultValue);
}

<div class="row justify-content-center">
	<div class="col-md-8 col-lg-6">
		<h1 class="mb-2">@Model.Content.Name</h1>
		<p class="mb-4">@Text("Member.LoggedInAs", "Logged in as") <strong>@Model.MemberName</strong></p>

		@* Här kan medlemmens stjärnbetyg visas senare (byggvecka 3). *@

		@using (Html.BeginUmbracoForm<UmbLoginStatusController>(nameof(UmbLoginStatusController.HandleLogout), new { RedirectUrl = Model.StartPage?.Url() ?? "/" }))
		{
			<button type="submit" class="btn btn-outline-secondary">@Text("Member.LogoutButton", "Log out")</button>
		}
	</div>
</div>