@using OutdoorGuide.Models.ViewModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<TrailsPageViewModel>

@{
	Layout = "root.cshtml";
}

@* Leder i samma stil som Platser och kommunsidan (OUT-105): brödsmulor, rubrik med ingress och ett kort per aktivitet *@
@await Html.PartialAsync("breadcrumbs", Model.Content)

<header class="place-header">
	<h1>@Model.Content.Name</h1>
	@if (!string.IsNullOrWhiteSpace(Model.Content.Intro))
	{
		<p class="place-intro">@Model.Content.Intro</p>
	}
</header>

@if (Model.Activities.Count > 0)
{
	<ul class="trail-grid">
		@foreach (var activity in Model.Activities)
		{
			<li>@await Html.PartialAsync("categoryCard", activity)</li>
		}
	</ul>
}
