@using OutdoorGuide.Models
@using OutdoorGuide.Models.ViewModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<PlacesPageViewModel>

@{
	Layout = "root.cshtml";

	string Text(string key, string defaultValue) => Umbraco.GetDictionaryValueOrDefault(key, defaultValue);
}

@* Platser: varje region som rubrik, med dess kommuner som kort (OUT-101) *@
<header class="place-header">
	<h1>@Model.Content.Name</h1>
	@if (!string.IsNullOrWhiteSpace(Model.Content.Intro))
	{
		<p class="place-intro">@Model.Content.Intro</p>
	}
</header>

@foreach (var region in Model.Regions)
{
	var municipalities = Model.MunicipalitiesByRegion.GetValueOrDefault(region.Key) ?? Array.Empty<MunicipalityCard>();
	var headingId = $"region-{region.Key:N}";

	<section class="place-region" aria-labelledby="@headingId">
		<h2 id="@headingId" class="place-section-heading"><a href="@region.Url()">@region.Name</a></h2>

		@if (!string.IsNullOrWhiteSpace(region.Intro))
		{
			<p class="place-region-intro">@region.Intro</p>
		}

		@if (municipalities.Count == 0)
		{
			<p class="start-trails-empty">@Text("Places.NoMunicipalities", "There are no municipalities here yet.")</p>
		}
		else
		{
			<ul class="trail-grid">
				@foreach (var card in municipalities)
				{
					<li>@await Html.PartialAsync("municipalityCard", card)</li>
				}
			</ul>
		}
	</section>
}
