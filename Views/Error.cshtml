@using OutdoorGuide.Business.Migrations
@using OutdoorGuide.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IPageViewModel>

@{
	Layout = "root.cshtml";
}

<h1>@Model.Content.Name</h1>
<p>@Model.Content.Value(AddRegionAndMunicipality.IntroAlias)</p>

@if (Model.StartPage != null)
{
	@* Startsidans namn är "Hem" eller "Home", så länken behöver ingen dictionary item *@
	<p><a href="@Model.StartPage.Url()">@Model.StartPage.Name</a></p>
}