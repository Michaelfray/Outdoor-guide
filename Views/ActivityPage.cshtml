@using OutdoorGuide.Models.ViewModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ActivityPageViewModel>

@{
	Layout = "root.cshtml";

	string Text(string key, string defaultValue) => Umbraco.GetDictionaryValueOrDefault(key, defaultValue);
}

@* Aktivitetssidan i samma stil som kommunsidan (OUT-105): undersidorna som kort, och sedan alla leder med betyg *@
@await Html.PartialAsync("breadcrumbs", Model.Content)

<header class="place-header">
	<h1>@Model.Content.Name</h1>
	@if (!string.IsNullOrWhiteSpace(Model.Content.Intro))
	{
		<p class="place-intro">@Model.Content.Intro</p>
	}
</header>

@if (Model.Categories.Count > 0)
{
	<section class="activity-categories" aria-labelledby="activity-categories-heading">
		<div class="start-trails-header">
			<h2 id="activity-categories-heading">@Text("Activity.Categories", "Types of trips")</h2>
		</div>

		<ul class="trail-grid">
			@foreach (var category in Model.Categories)
			{
				<li>@await Html.PartialAsync("categoryCard", category)</li>
			}
		</ul>
	</section>
}

<section class="start-trails" aria-labelledby="activity-trails-heading">
	<div class="start-trails-header">
		<h2 id="activity-trails-heading">@Text("Activity.Trails", "All trails")</h2>
	</div>

	@if (Model.Trails.Count == 0)
	{
		<p class="start-trails-empty">@Text("Activity.NoTrails", "There are no trails for this activity yet.")</p>
	}
	else
	{
		<ul class="trail-grid">
			@foreach (var trail in Model.Trails)
			{
				@* Betyget skickas med till kortet. Leder utan röster får inget, och då visas ingen stjärna *@
				var cardData = new ViewDataDictionary(ViewData) { ["Rating"] = Model.Ratings.GetValueOrDefault(trail.Key) };
				<li>@await Html.PartialAsync("trailCard", trail, cardData)</li>
			}
		</ul>
	}
</section>
