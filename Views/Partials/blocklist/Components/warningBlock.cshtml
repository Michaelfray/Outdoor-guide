@using Umbraco.Cms.Core.Models.Blocks
@inherits UmbracoViewPage<BlockListItem<WarningBlock>>

@{
    // Skip the block if the editor left the text empty
    if (string.IsNullOrWhiteSpace(Model.Content.Text)) { return; }
}

<div class="block-warning" role="note">
    @* Warning triangle, only decoration, so screen readers skip it *@
    <svg class="block-warning__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M12 3 2 21h20z"></path>
        <path d="M12 10v5M12 18v.01"></path>
    </svg>
    <p class="block-warning__text">
        <strong>@Umbraco.GetDictionaryValueOrDefault("Trail.Warning", "Warning").</strong>
        @Model.Content.Text
    </p>
</div>