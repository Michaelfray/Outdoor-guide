@model string

@* Ikonen i bildytan på ett kort som saknar bild (OUT-102). Modellen är aktivitetens värde (hiking, paddling,
   cycling, winter) eller "place" för kommunkort. Ren dekoration, så skärmläsare hoppar över den *@
<svg class="trail-tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
	 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
	@switch (Model)
	{
		case "paddling":
			@* En paddel över vågor *@
			<path d="M4 20 16.5 7.5"></path>
			<path d="M15 4.5c1.5-1.5 4-1 4.5.5s-.5 3-2 3.5l-2 .5-1-1 .5-3.5z"></path>
			<path d="M2 17c1.5 1 3 1 4.5 0s3-1 4.5 0 3 1 4.5 0 3-1 4.5 0"></path>
			break;
		case "cycling":
			@* En cykel *@
			<circle cx="6" cy="16" r="3.5"></circle>
			<circle cx="18" cy="16" r="3.5"></circle>
			<path d="M6 16 10 9h6l2 7"></path>
			<path d="M10 9 8.5 6H7"></path>
			<path d="M14 6h2.5l-.5 3"></path>
			break;
		case "winter":
			@* En snöflinga *@
			<path d="M12 2v20M3.3 7l17.4 10M3.3 17 20.7 7"></path>
			<path d="m9.5 3.5 2.5 2 2.5-2M9.5 20.5l2.5-2 2.5 2"></path>
			break;
		case "place":
			@* En kartnål *@
			<path d="M12 21s-7-6.5-7-12a7 7 0 0 1 14 0c0 5.5-7 12-7 12z"></path>
			<circle cx="12" cy="9" r="2.5"></circle>
			break;
		default:
			@* Berg, för vandring och leder utan aktivitet *@
			<path d="m2 20 7-11 4 6 3-4 6 9z"></path>
			<path d="m7.5 11.5 1.5 1.5 1.5-1.5"></path>
			break;
	}
</svg>
