@inherits UmbracoViewPage<IPublishedContent>

@{
	string Text(string key, string defaultValue) => Umbraco.GetDictionaryValueOrDefault(key, defaultValue);
}

@* Brödsmulor från startsidan ner till sidan: Hem / Stockholms län / Nacka (OUT-101).
   Samma utseende som på ledsidan, där klassen trail-breadcrumbs finns i trail.css *@
<nav class="trail-breadcrumbs" aria-label="@Text("Trail.Breadcrumbs", "Breadcrumbs")">
	<ol>
		@foreach (var crumb in Model.Ancestors().Reverse())
		{
			<li><a href="@crumb.Url()">@crumb.Name</a></li>
		}
		<li aria-current="page">@Model.Name</li>
	</ol>
</nav>
