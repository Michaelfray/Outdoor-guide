@using OutdoorGuide.Models
@inherits UmbracoViewPage<IPageViewModel>

<footer class="site-footer py-5">
    <div class="container">
        <div class="row gy-4">
            <div class="col-md-6">
                <a class="site-footer-brand" href="@(Model.StartPage?.Url() ?? "/")">Friluftsguiden</a>
                <p class="mb-0">@Umbraco.GetDictionaryValueOrDefault("Footer.Tagline", "Trails in Stockholm County.")
                </p>
            </div>
            <nav class="col-md-6" aria-label="@Umbraco.GetDictionaryValueOrDefault("Footer.Links", "Links")">
                <ul class="list-unstyled d-flex flex-wrap gap-3 justify-content-md-end mb-0">
                    @foreach (var item in Model.MenuItems)
                    {
                        <li><a href="@item.Url()">@item.Name</a></li>
                    }

                    @* Allemansrätten, Integritet och cookies med flera: textsidor som inte ligger i menyn (OUT-47) *@
                    @foreach (var legalPage in LegalPages.ForFooter(Model.StartPage, Model.MenuItems))
                    {
                        <li><a href="@legalPage.Url()">@legalPage.Name</a></li>
                    }

                    @* Visar cookie-rutan igen, så att besökaren kan ändra sitt val (OUT-94) *@
                    <li>
                        <button type="button" class="site-footer-link-button" id="cookie-settings">
                            @Umbraco.GetDictionaryValueOrDefault("Cookie.Settings", "Cookie settings")
                        </button>
                    </li>
                </ul>
            </nav>
        </div>
        @await Html.PartialAsync("NewsletterForm", Model)
        <p class="small mt-4 mb-0">
            @Umbraco.GetDictionaryValueOrDefault("Footer.WeatherSource", "Weather from")
            <a href="https://open-meteo.com/">Open-Meteo</a>
        </p>
    </div>
</footer>

<script>
    // Tar bort valet i cookie-rutan och laddar om sidan, så att rutan visas igen (OUT-94)
    document.getElementById('cookie-settings').addEventListener('click', function () {
        // Samma inställningar som när cookien sattes i cookie-rutan, annars tas den inte bort
        var secure = location.protocol === 'https:' ? '; Secure' : '';
        document.cookie = '@CookieConsent.CookieName=; Max-Age=0; Path=/; SameSite=Lax' + secure;
        location.reload();
    });
</script>