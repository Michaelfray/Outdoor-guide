@using OutdoorGuide.Models.ViewModels
@inherits UmbracoViewPage<MunicipalityPageViewModel>

@{
	string Text(string key, string defaultValue) => Umbraco.GetDictionaryValueOrDefault(key, defaultValue);

	var region = Model.Content.AncestorOrSelf<Region>();
}

@if (region != null)
{
	<p>
		@Text("Municipality.Region", "Region"):
		<a href="@region.Url()">@region.Name</a>
	</p>
}

@if (Model.HasTrails)
{
	@await Html.PartialAsync("trailFilter", Model.Filter)
}

<section>
	<h2>@Text("Municipality.Trails", "Trails in the municipality")</h2>

	@if (!Model.HasTrails)
	{
		<p>@Text("Municipality.NoTrails", "There are no trails here yet.")</p>
	}
	else if (Model.Trails.Count == 0)
	{
		<p>@Text("Filter.NoResults", "No trails match the filter.")</p>
	}
	else
	{
		<ul>
			@foreach (var trail in Model.Trails)
			{
				<li>
					<h3>@trail.Name</h3>
					@if (!string.IsNullOrEmpty(trail.Intro))
					{
						<p>@trail.Intro</p>
					}
					<a href="@trail.Url()">@Text("Common.ReadMore", "Read more")<span class="visually-hidden">: @trail.Name</span></a>
				</li>
			}
		</ul>
	}
</section>