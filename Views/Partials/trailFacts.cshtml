@using OutdoorGuide.Models
@inherits UmbracoViewPage<Trail>

@{
	string Text(string key, string defaultValue) => Umbraco.GetDictionaryValueOrDefault(key, defaultValue);

	string YesNo(bool value) => value ? Text("Common.Yes", "Yes") : Text("Common.No", "No");
}

@* Each fact is a div with dt and dd, so the list can be a grid with two columns *@
<section class="trail-card trail-facts-card" aria-labelledby="trail-facts-heading">
	<h2 id="trail-facts-heading">@Text("Trail.Facts", "Facts")</h2>

	<dl class="trail-facts">
		@if (Model.Length > 0)
		{
			<div>
				<dt>@Text("Trail.Length", "Length")</dt>
				<dd>@Model.Length.ToString("0.#") km</dd>
			</div>
		}

		@if (Model.Duration > 0)
		{
			<div>
				<dt>@Text("Trail.Time", "Time")</dt>
				<dd>@Model.Duration.ToString("0.#") @Text("Trail.Hours", "hours")</dd>
			</div>
		}

		@if (!string.IsNullOrEmpty(Model.Difficulty))
		{
			<div>
				<dt>@Text("Trail.Difficulty", "Difficulty")</dt>
				<dd>@Text(DifficultyValues.DictionaryKey(Model.Difficulty), Model.Difficulty)</dd>
			</div>
		}

		<div>
			<dt>@Text("Trail.ChildFriendly", "Child friendly")</dt>
			<dd>@YesNo(Model.ChildFriendly)</dd>
		</div>

		<div>
			<dt>@Text("Trail.Loop", "Loop trail")</dt>
			<dd>@YesNo(Model.Loop)</dd>
		</div>
	</dl>
</section>
