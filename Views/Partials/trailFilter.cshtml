@using OutdoorGuide.Models
@inherits UmbracoViewPage<TrailFilter>

@{
	string Text(string key, string defaultValue) => Umbraco.GetDictionaryValueOrDefault(key, defaultValue);

	var pageWithoutFilter = Context.Request.Path.ToString();
}

@* Filtret enligt designen. Aktivitet och svårighet är radioknappar som ser ut som "pills", så att formuläret
   fungerar som vanlig GET utan JavaScript. Valet syns i adressen och går att dela, som förut. *@
<section class="trail-filter" aria-labelledby="trail-filter-heading">
	<h2 id="trail-filter-heading" class="visually-hidden">@Text("Filter.Title", "Filter")</h2>

	<form method="get" action="@pageWithoutFilter" class="trail-filter-form">
		<fieldset class="trail-filter-row">
			<legend class="trail-filter-legend">@Text("Trail.Activity", "Activity")</legend>
			<div class="trail-filter-pills">
				<label class="trail-pill">
					<input type="radio" name="@TrailFilter.ActivityKey" value="" checked="@(Model.Activity == null)" />
					<span>@Text("Filter.All", "All")</span>
				</label>
				@foreach (var value in ActivityValues.All)
				{
					<label class="trail-pill">
						<input type="radio" name="@TrailFilter.ActivityKey" value="@value" checked="@(Model.Activity == value)" />
						<span>@Text(ActivityValues.DictionaryKey(value), value)</span>
					</label>
				}
			</div>
		</fieldset>

		<fieldset class="trail-filter-row">
			<legend class="trail-filter-legend">@Text("Trail.Difficulty", "Difficulty")</legend>
			<div class="trail-filter-pills">
				<label class="trail-pill">
					<input type="radio" name="@TrailFilter.DifficultyKey" value="" checked="@(Model.Difficulty == null)" />
					<span>@Text("Filter.All", "All")</span>
				</label>
				@foreach (var value in DifficultyValues.All)
				{
					<label class="trail-pill">
						<input type="radio" name="@TrailFilter.DifficultyKey" value="@value" checked="@(Model.Difficulty == value)" />
						<span>@Text(DifficultyValues.DictionaryKey(value), value)</span>
					</label>
				}
			</div>
		</fieldset>

		<div class="trail-filter-bottom">
			<div class="trail-filter-field">
				<label for="trail-filter-length">@Text("Trail.Length", "Length")</label>
				<select id="trail-filter-length" name="@TrailFilter.LengthKey">
					<option value="">@Text("Filter.AllLengths", "All lengths")</option>
					@foreach (var value in LengthValues.All)
					{
						<option value="@value" selected="@(Model.Length == value)">@Text(LengthValues.DictionaryKey(value), value)</option>
					}
				</select>
			</div>

			<label class="trail-filter-check">
				<input name="@TrailFilter.ChildFriendlyKey" type="checkbox" value="true" checked="@Model.ChildFriendly" />
				@Text("Filter.OnlyChildFriendly", "Child friendly only")
			</label>

			<div class="trail-filter-actions">
				@if (Model.IsActive)
				{
					<a href="@pageWithoutFilter" class="trail-filter-clear">@Text("Filter.Clear", "Clear filter")</a>
				}
				<button type="submit" class="trail-filter-submit">@Text("Filter.Submit", "Show trails")</button>
			</div>
		</div>
	</form>
</section>
