@using System.Globalization
@using OutdoorGuide.Models
@using OutdoorGuide.Models.ViewModels
@inherits UmbracoViewPage<TrailPageViewModel>

@{
	string Text(string key, string defaultValue) => Umbraco.GetDictionaryValueOrDefault(key, defaultValue);
	string Describe(int code) => Text(WeatherCodes.DictionaryKey(code), WeatherCodes.Name(code));

	// Open-Meteo ger vinden i km/h, men i Sverige anges vind i m/s
	string Wind(double kmh) => (kmh / 3.6).ToString("0", CultureInfo.CurrentCulture) + " m/s";

	var current = Model.Forecast?.Current;
	var daily = Model.Forecast?.Daily;

	// Open-Meteo skickar en lista per fält. Läs bara så många dagar som alla listor har, och högst fyra
	var days = daily == null ? 0 : new[] { daily.Time.Count, daily.WeatherCode.Count, daily.TemperatureMin.Count, daily.TemperatureMax.Count, 4 }.Min();

	// Sajtens tidszon, inte serverns, så att tiden blir densamma oavsett var sajten körs
	var fetched = Model.FetchedUtc is DateTime utc
		? TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), TimeZoneInfo.FindSystemTimeZoneById("Europe/Stockholm"))
		: (DateTime?)null;
}

@if (Model.HasCoordinates)
{
	<section class="trail-weather my-4" aria-labelledby="trail-weather-heading">
		<h2 id="trail-weather-heading">@Text("Weather.Title", "Weather")</h2>

		@if (current == null)
		{
			<p>@Text("Weather.Unavailable", "The weather can't be shown right now.")</p>
		}
		else
		{
			@if (fetched != null)
			{
				<p class="text-muted small mb-1">@Text("Weather.Updated", "Updated") @fetched.Value.ToString("HH:mm", CultureInfo.InvariantCulture)</p>
			}

			@if (Model.IsStale)
			{
				<p class="text-warning-emphasis small">@Text("Weather.Stale", "The forecast may be out of date.")</p>
			}

			<p>
				<strong>@Text("Weather.Now", "Right now"):</strong>
				@Describe(current.WeatherCode), @current.Temperature.ToString("0") °C, @Text("Weather.Wind", "wind") @Wind(current.WindSpeed)
			</p>

			@if (days > 0)
			{
				<h3 class="h5">@Text("Weather.Forecast", "Coming days")</h3>
				<ul class="list-unstyled">
					@for (var i = 0; i < days; i++)
					{
						var day = DateOnly.ParseExact(daily!.Time[i], "yyyy-MM-dd", CultureInfo.InvariantCulture);
						<li>@day.ToString("dddd d MMM", CultureInfo.CurrentCulture): @Describe(daily.WeatherCode[i]), @daily.TemperatureMin[i].ToString("0")–@daily.TemperatureMax[i].ToString("0") °C</li>
					}
				</ul>
			}
		}
	</section>
}