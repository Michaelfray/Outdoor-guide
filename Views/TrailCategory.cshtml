@using OutdoorGuide.Models.ViewModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<TrailCategoryViewModel>

@{
	Layout = "root.cshtml";

	string Text(string key, string defaultValue) => Umbraco.GetDictionaryValueOrDefault(key, defaultValue);

	// "5 leder" eller "1 led", som rubriken på kommunsidan
	var heading = Model.Trails.Count == 1
		? Text("Places.TrailCountOne", "1 trail")
		: string.Format(Text("Places.TrailCount", "{0} trails"), Model.Trails.Count);
}

@* Undersidan i samma stil som kommunsidan (OUT-105): brödsmulor, rubrik med ingress och lederna som kort *@
@await Html.PartialAsync("breadcrumbs", Model.Content)

<header class="place-header">
	<h1>@Model.Content.Name</h1>
	@if (!string.IsNullOrWhiteSpace(Model.Content.Intro))
	{
		<p class="place-intro">@Model.Content.Intro</p>
	}
</header>

<section class="start-trails" aria-labelledby="category-trails-heading">
	@if (Model.Trails.Count == 0)
	{
		<h2 id="category-trails-heading" class="visually-hidden">@Text("TrailCategory.Trails", "Trails")</h2>
		<p class="start-trails-empty">@Text("TrailCategory.NoTrails", "There are no trails here yet.")</p>
	}
	else
	{
		<div class="start-trails-header">
			<h2 id="category-trails-heading">@heading</h2>
		</div>

		<ul class="trail-grid">
			@foreach (var trail in Model.Trails)
			{
				@* Betyget skickas med till kortet. Leder utan röster får inget, och då visas ingen stjärna *@
				var cardData = new ViewDataDictionary(ViewData) { ["Rating"] = Model.Ratings.GetValueOrDefault(trail.Key) };
				<li>@await Html.PartialAsync("trailCard", trail, cardData)</li>
			}
		</ul>
	}
</section>
