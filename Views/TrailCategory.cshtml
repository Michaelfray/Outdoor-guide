@using OutdoorGuide.Models.ViewModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<TrailCategoryViewModel>

@{
	Layout = "root.cshtml";

	string Text(string key, string defaultValue) => Umbraco.GetDictionaryValueOrDefault(key, defaultValue);
}

<h1 class="mb-3">@Model.Content.Name</h1>

@if (!string.IsNullOrWhiteSpace(Model.Content.Intro))
{
	<p class="lead">@Model.Content.Intro</p>
}

<section class="mt-4" aria-labelledby="category-trails-heading">
	<h2 id="category-trails-heading">@Text("TrailCategory.Trails", "Trails")</h2>

	@if (Model.Trails.Count == 0)
	{
		<p>@Text("TrailCategory.NoTrails", "There are no trails here yet.")</p>
	}
	else
	{
		<ul class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 list-unstyled">
			@foreach (var trail in Model.Trails)
			{
				<li class="col">@await Html.PartialAsync("trailCard", trail)</li>
			}
		</ul>
	}
</section>