@using OutdoorGuide.Models.ViewModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<StartPageViewModel>

@{
	Layout = "root.cshtml";

	string Text(string key, string defaultValue) => Umbraco.GetDictionaryValueOrDefault(key, defaultValue);

	// Rubriken från fältet Title, och sidans namn om fältet är tomt
	var title = string.IsNullOrWhiteSpace(Model.Content.Title) ? Model.Content.Name : Model.Content.Title;

	// "Visar 4 av 6 leder"
	var showing = string.Format(
		Text("Filter.Showing", "Showing {0} of {1} trails"),
		Model.Trails.Count,
		Model.TotalTrails);
}

@* Den gröna toppen enligt designen (Startsida – dator och mobil) *@
<section class="start-hero" aria-labelledby="start-heading">
	<p class="start-eyebrow">@Text("Start.Eyebrow", "Trails in Stockholm County")</p>
	<h1 id="start-heading">@title</h1>
	@if (!string.IsNullOrWhiteSpace(Model.Content.Intro))
	{
		<p class="start-intro">@Model.Content.Intro</p>
	}
</section>

@if (Model.HasTrails)
{
	<section class="start-trails" aria-labelledby="start-trails-heading">
		<div class="start-trails-header">
			<h2 id="start-trails-heading">@Text("Activity.Trails", "All trails")</h2>
			<p class="start-trails-count" role="status">@showing</p>
		</div>

		@await Html.PartialAsync("trailFilter", Model.Filter)

		@if (Model.Trails.Count == 0)
		{
			<p class="start-trails-empty">@Text("Filter.NoResults", "No trails match the filter.")</p>
		}
		else
		{
			<ul class="trail-grid">
				@foreach (var trail in Model.Trails)
				{
					<li>@await Html.PartialAsync("trailCard", trail)</li>
				}
			</ul>
		}
	</section>
}
