@using OutdoorGuide.Models.ViewModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<StartPageViewModel>

@{
	Layout = "root.cshtml";

	string Text(string key, string defaultValue) => Umbraco.GetDictionaryValueOrDefault(key, defaultValue);

	// Rubriken från fältet Title, och sidans namn om fältet är tomt
	var title = string.IsNullOrWhiteSpace(Model.Content.Title) ? Model.Content.Name : Model.Content.Title;

	// "Visar 4 av 6 leder"
	var showing = string.Format(
		Text("Filter.Showing", "Showing {0} of {1} trails"),
		Model.Trails.Count,
		Model.TotalTrails);
}

@* Den gröna toppen enligt designen (Startsida – dator och mobil), med en bild från Tyresta bakom (OUT-107) *@
<section class="start-hero" aria-labelledby="start-heading">
	<div class="start-hero-text">
		<p class="start-eyebrow">@Text("Start.Eyebrow", "Trails in Stockholm County")</p>
		<h1 id="start-heading">@title</h1>
		@if (!string.IsNullOrWhiteSpace(Model.Content.Intro))
		{
			<p class="start-intro">@Model.Content.Intro</p>
		}

		@* Sökrutan skickar till söksidan (OUT-74) med ?q=, som söksidans eget formulär (OUT-90) *@
		@if (Model.SearchUrl != null)
		{
			<form class="start-search" method="get" action="@Model.SearchUrl" role="search">
				<label for="start-search-query">@Text("Search.Label", "Search")</label>
				<div class="start-search-row">
					<input type="search" id="start-search-query" name="q" maxlength="100"
						   placeholder="@Text("Search.Placeholder", "Search trail or municipality")" />
					<button type="submit">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
						@Text("Search.SearchButton", "Search")
					</button>
				</div>
			</form>
		}
	</div>

	@* Väder i Stockholm till höger på dator och under texten på mobil (OUT-103). Saknas prognosen visas inget *@
	@if (Model.StockholmWeather != null)
	{
		@await Html.PartialAsync("startWeather", Model.StockholmWeather)
	}

	@* Bilden bakom toppen ligger i start.css (OUT-107). Licensen CC BY-SA kräver fotografens namn och en länk *@
	<p class="start-hero-credit">
		@Text("Start.PhotoCredit", "Photo"):
		<a href="https://commons.wikimedia.org/wiki/File:Stensj%C3%B6n,_Tyresta_national_park,_2007-07-31,_northern_shore_on_Stensj%C3%B6borg,_view_southeast.jpeg">TimSE</a>,
		<a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>
	</p>
</section>

@if (Model.HasTrails)
{
	<section class="start-trails" aria-labelledby="start-trails-heading">
		<div class="start-trails-header">
			<h2 id="start-trails-heading">@Text("Activity.Trails", "All trails")</h2>
			<p class="start-trails-count" role="status">@showing</p>
		</div>

		@await Html.PartialAsync("trailFilter", Model.Filter)

		@if (Model.Trails.Count == 0)
		{
			<p class="start-trails-empty">@Text("Filter.NoResults", "No trails match the filter.")</p>
		}
		else
		{
			<ul class="trail-grid">
				@foreach (var trail in Model.Trails)
				{
					@* Betyget skickas med till kortet. Leder utan röster får inget, och då visas ingen stjärna *@
					var cardData = new ViewDataDictionary(ViewData) { ["Rating"] = Model.Ratings.GetValueOrDefault(trail.Key) };
					<li>@await Html.PartialAsync("trailCard", trail, cardData)</li>
				}
			</ul>
		}
	</section>
}

@* Säsongstips-kortet under lederna (OUT-103) *@
@if (Model.SeasonalTips != null)
{
	<section class="start-seasonal" aria-label="@Text("Start.SeasonalEyebrow", "Seasonal tips")">
		@await Html.PartialAsync("seasonalTipsCard", Model.SeasonalTips)
	</section>
}
