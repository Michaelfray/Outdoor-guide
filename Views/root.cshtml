@using OutdoorGuide.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IPageViewModel>
@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@Model.Content.Name</title>
	<meta name="description" content="@Model.Content.MetaDescription" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
		  crossorigin="anonymous" />
	<link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
	<link href="~/css/footer.css" rel="stylesheet" asp-append-version="true" />
	<link href="~/css/menu.css" rel="stylesheet" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">
	<header>
		@await Html.PartialAsync("menu", Model)
	</header>

	<main class="flex-grow-1">
		<div class="container py-4">
			@RenderBody()
		</div>
	</main>

 	 @await Html.PartialAsync("footer", Model)

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
			crossorigin="anonymous"></script>
</body>

</html>